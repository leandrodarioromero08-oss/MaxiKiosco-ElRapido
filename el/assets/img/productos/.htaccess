# Las fotos de productos son SOLO imágenes: nada de ejecutar scripts acá.
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|pl|py|cgi)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
